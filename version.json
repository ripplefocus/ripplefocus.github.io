on pending.\n- Added repeated checks and an overlay fallback for missed Douyin/Bilibili blocking when background activity display is disabled; real-device verification pending.\n- Fixed blocked websites in Firefox 159.\n- Chrome, Brave, Firefox and the x86 Opera build passed emulator tests. Edge, Samsung Internet, Chinese browsers and in-app web pages still need real-device verification.\n- This is a replacement APK for the earlier 0.1.13+28 build. Users of that build should download and install this package again; the unchanged version number will not trigger an update prompt.\n- Android only. The iPhone version remains v0.1.5.\n\nversionCode: 28\nsha256: a2faaab32ebf5875fc969b0690fb83151f7beb7d765e2b3c6bbad1a9936f74ed\n", "version": "0.1.13", "versionCode": 28, "apkSizeBytes": 9226197, "sha256": "a2faaab32ebf5875fc969b0690fb83151f7beb7d765e2b3c6bbad1a9936f74ed", "ipaSizeBytes": 7764400, "ipaSha256": "3b7fca162f27b7033e45fe762f59587214bb7cb2c9cd1f4dcf047afb4f472f0f", "iosVersion": "0.1.5", "downloadUrl": "https://ripplefocus.github.io/dl/ripple-v0.1.13.apk", "iosDownloadUrl": "https://ripplefocus.github.io/dl/ripple-v0.1.5.ipa", "mirrors": ["https://ripplefocus.github.io/dl/ripple-v0.1.13.apk", "https://gh-proxy.com/https://github.com/ripplefocus/ripplefocus.github.io/releases/download/v0.1.13/ripple-v0.1.13.apk", "https://github.com/ripplefocus/ripplefocus.github.io/releases/download/v0.1.13/ripple-v0.1.13.apk", "https://github.com/tumingke0/ripple/releases/download/v0.1.13/ripple-v0.1.13.apk"], "iosMirrors": ["https://ripplefocus.github.io/dl/ripple-v0.1.5.ipa", "https://gh-proxy.com/https://github.com/ripplefocus/ripplefocus.github.io/releases/download/v0.1.5/ripple-v0.1.5.ipa", "https://github.com/ripplefocus/ripplefocus.github.io/releases/download/v0.1.5/ripple-v0.1.5.ipa", "https://github.com/tumingke0/ripple/releases/download/v0.1.5/ripple-v0.1.5.ipa"]}