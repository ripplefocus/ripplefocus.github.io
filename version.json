, "avatar_url": "https://avatars.githubusercontent.com/u/14247548?v=4", "gravatar_id": "", "url": "https://api.github.com/users/tumingke0", "html_url": "https://github.com/tumingke0", "followers_url": "https://api.github.com/users/tumingke0/followers", "following_url": "https://api.github.com/users/tumingke0/following{/other_user}", "gists_url": "https://api.github.com/users/tumingke0/gists{/gist_id}", "starred_url": "https://api.github.com/users/tumingke0/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/tumingke0/subscriptions", "organizations_url": "https://api.github.com/users/tumingke0/orgs", "repos_url": "https://api.github.com/users/tumingke0/repos", "events_url": "https://api.github.com/users/tumingke0/events{/privacy}", "received_events_url": "https://api.github.com/users/tumingke0/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "content_type": "application/vnd.android.package-archive", "state": "uploaded", "size": 9203621, "digest": "sha256:b0b1bb409215409dc0641c92d22bf223e5a5bfa539dc23a4bba5d57d7ad3b938", "download_count": 0, "created_at": "2026-11-04T09:18:09Z", "updated_at": "2026-11-04T09:18:10Z", "browser_download_url": "https://github.com/ripplefocus/ripplefocus.github.io/releases/download/v0.1.11/ripple-v0.1.11.apk"}], "tarball_url": "https://api.github.com/repos/ripplefocus/ripplefocus.github.io/tarball/v0.1.11", "zipball_url": "https://api.github.com/repos/ripplefocus/ripplefocus.github.io/zipball/v0.1.11", "body": "## 更新内容 / What's New\n- 修复小米和澎湃OS 上开自启动、省电设置时被踢回桌面、一直弹窗的问题。现在点「去开启」会直接打开小米安全中心里的自启动页和省电策略页。\n- 权限页在小米手机上改用小米自己的菜单路径，电池那一行会提醒把涟漪的省电策略改成「无限制」。自启动页刚打开就被弹回来时，涟漪不再反复问「设置好了吗」，会在这一行下面提示，照路径开好后点「已开好」就行。\n- 防卸载拦住了更多卸载入口，包括小米桌面的卸载弹窗和小米应用商店。\n- 小米手机上，防卸载页会建议打开「高级保护」。澎湃OS 会替你停用设备管理器，开了高级保护，系统会拒绝卸载涟漪。\n- 这次只更新安卓版，iPhone 版还是 v0.1.5。\n- Fixed being sent back to the home screen with repeated popups when turning on Autostart and battery settings on Xiaomi and HyperOS. Tapping Grant now opens the Autostart page and the battery saver page in Xiaomi's Security app directly.\n- On Xiaomi phones the permissions page now shows Xiaomi's own menu paths, and the battery row reminds you to set Ripple's battery saver to \"No restrictions\". If the Autostart page bounces back right away, Ripple no longer keeps asking whether you turned it on. A short note appears under that row, and you tap Done after turning it on yourself.\n- Anti-uninstall now blocks more uninstall entry points, including the Xiaomi launcher's uninstall dialog and the Xiaomi app store.\n- On Xiaomi phones the anti-uninstall page now suggests turning on Advanced Protection. HyperOS turns off Device Admin for you, and with Advanced Protection on the system refuses to uninstall Ripple.\n- This update is for Android only. The iPhone version stays at v0.1.5.\n\nversionCode: 26\nsha256: b0b1bb409215409dc0641c92d22bf223e5a5bfa539dc23a4bba5d57d7ad3b938\n", "version": "0.1.11", "versionCode": 26, "apkSizeBytes": 9203621, "sha256": "b0b1bb409215409dc0641c92d22bf223e5a5bfa539dc23a4bba5d57d7ad3b938", "ipaSizeBytes": 7764400, "ipaSha256": "3b7fca162f27b7033e45fe762f59587214bb7cb2c9cd1f4dcf047afb4f472f0f", "iosVersion": "0.1.5", "downloadUrl": "https://ripplefocus.github.io/dl/ripple-v0.1.11.apk", "iosDownloadUrl": "https://ripplefocus.github.io/dl/ripple-v0.1.5.ipa", "mirrors": ["https://ripplefocus.github.io/dl/ripple-v0.1.11.apk", "https://gh-proxy.com/https://github.com/ripplefocus/ripplefocus.github.io/releases/download/v0.1.11/ripple-v0.1.11.apk", "https://github.com/ripplefocus/ripplefocus.github.io/releases/download/v0.1.11/ripple-v0.1.11.apk", "https://github.com/tumingke0/ripple/releases/download/v0.1.11/ripple-v0.1.11.apk"], "iosMirrors": ["https://ripplefocus.github.io/dl/ripple-v0.1.5.ipa", "https://gh-proxy.com/https://github.com/ripplefocus/ripplefocus.github.io/releases/download/v0.1.5/ripple-v0.1.5.ipa", "https://github.com/ripplefocus/ripplefocus.github.io/releases/download/v0.1.5/ripple-v0